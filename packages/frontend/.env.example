# Frontend Environment Variables (TASK-121)
#
# Copy this file to .env.local and fill in the values.
# These variables are injected at build time by Vite.
#
# Competition-day flow:
#   AWS/CDK outputs → build environment variables → vite build → deployment
#
# DO NOT commit actual endpoint values or secrets to version control.

# HTTP API base endpoint (required)
# Must use http: or https: protocol
VITE_API_ENDPOINT=https://du6wcg8xe4.execute-api.us-west-2.amazonaws.com

# WebSocket endpoint (optional in VITE_API_MODE=demo)
# Must use ws: or wss: protocol when supplied.
# Demo mode leaves this empty and falls back to HTTP polling.
VITE_WS_ENDPOINT=

# Environment profile (required)
# Valid values: LOCAL_MOCK, COMPETITION_AWS, TEST, DEMO
VITE_APP_ENV=DEMO

# API access mode (optional, defaults to "production")
# - production: the original demo client hits every canonical route.
# - demo:       the Demo API Compatibility Adapter is selected; only
#               /demo/timeseries, /demo/incidents, /what-if are used.
VITE_API_MODE=demo
