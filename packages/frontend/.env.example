# Frontend Environment Variables (TASK-121)
#
# Copy this file to .env.local and fill in the values.
# These variables are injected at build time by Vite.
#
# Competition-day flow:
#   AWS/CDK outputs → build environment variables → vite build → deployment
#
# DO NOT commit actual endpoint values or secrets to version control.

# HTTP API base endpoint (required)
# Must use http: or https: protocol
VITE_API_ENDPOINT=

# WebSocket endpoint (required)
# Must use ws: or wss: protocol
VITE_WS_ENDPOINT=

# Environment profile (required)
# Valid values: LOCAL_MOCK, COMPETITION_AWS, TEST
VITE_APP_ENV=LOCAL_MOCK
