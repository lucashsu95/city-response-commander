    "test:watch": "vitest",
    "sync:map-data": "node scripts/sync-map-data.mjs"
  },
  "dependencies": {
    "@city-commander/shared-schemas": "*",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
