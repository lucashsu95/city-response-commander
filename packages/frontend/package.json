{
  "name": "@city-commander/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React/TS Dashboard 前端",
  "scripts": {
    "dev": "node scripts/sync-map-data.mjs && vite",
    "build": "node scripts/sync-map-data.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
