exports[`Anomaly popup snapshot > matches the anomaly popup snapshot > anomaly-popup-open 1`] = `"<div class="anomaly-popup__backdrop" data-testid="anomaly-popup-backdrop"><div class="anomaly-popup" role="alertdialog" aria-modal="true" aria-labelledby="anomaly-popup-title" aria-describedby="anomaly-popup-description" data-testid="anomaly-popup" data-anomaly-identity="RD_TPE_0007@2026-05-20 22:10" data-anomaly-source="realtime"><h2 id="anomaly-popup-title" class="anomaly-popup__title">偵測到異常</h2><p id="anomaly-popup-description" class="anomaly-popup__description" data-testid="anomaly-popup-description">中山北路南下車道已達癱瘓等級，請立即啟動替代動線。</p><p class="anomaly-popup__badge anomaly-popup__badge--provisional" data-testid="anomaly-popup-provisional">暫定政策（provisional）</p><dl class="anomaly-popup__details"><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">來源</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-source">即時推播（WebSocket）</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">分類</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-category">ROAD_SATURATION</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">對象</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-entity">RD_TPE_0007</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">觀測時間</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-observed-at">2026-05-20 22:10</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">後端門檻說明</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-threshold">SOP-1 A 級</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">後端觀測值</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-value">0.97</dd></div><div class="anomaly-popup__detail"><dt class="anomaly-popup__detail-label">後端訊號</dt><dd class="anomaly-popup__detail-value" data-testid="anomaly-popup-signals">ROAD_SATURATION</dd></div></dl><div class="anomaly-popup__actions"><button type="button" class="anomaly-popup__close" data-testid="anomaly-popup-close">關閉</button></div></div></div>"`;

exports[`Dashboard stale/degraded state snapshot > matches the stale/degraded snapshot > dashboard-stale-degraded 1`] = `"<div class="dashboard-shell"><header class="dashboard-header" role="banner"><h1 class="dashboard-header__title">城市交通應變 AI 指揮台</h1><div class="operational-status-bar" role="region" aria-label="系統狀態"><span class="status-indicator status-indicator--fresh" role="status"><span class="status-indicator__dot" aria-hidden="true"></span><span class="status-indicator__text">資料為最新</span></span><span class="status-indicator status-indicator--degraded" role="status" aria-live="polite" data-connection-mode="polling"><span class="status-indicator__dot" aria-hidden="true"></span><span class="status-indicator__icon" aria-hidden="true">⟳</span><span class="status-indicator__text">即時連線降級為輪詢</span></span><span class="status-indicator status-indicator--polling-error" role="alert" aria-live="assertive"><span class="status-indicator__icon" aria-hidden="true">⚠</span><span class="status-indicator__text">輪詢更新失敗：GET /roads 逾時</span></span></div></header><main class="dashboard-main" role="main"><div class="dashboard-grid"><section class="dashboard-region dashboard-region--timeline" aria-labelledby="timeline-heading"><h2 id="timeline-heading" class="dashboard-region__heading">時間軸</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的時間軸資料</span></div></div></section><section class="dashboard-region dashboard-region--roads" aria-labelledby="roads-heading"><h2 id="roads-heading" class="dashboard-region__heading">路段車流</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="road-panel"><h3 class="road-panel__heading">路段車流</h3><div class="road-panel__status" role="status" aria-live="polite">背景更新失敗：輪詢逾時（顯示上次成功的路段資料）</div><p class="road-panel__snapshot-timestamp">快照時間：2026-05-20 22:00</p><ul class="road-panel__list" aria-label="路段車流列表"><li class="road-panel__row" data-segment-id="RD_TPE_002"><div class="road-panel__row-main"><span class="road-panel__road-name">光復南路</span><span class="road-panel__segment-id">RD_TPE_002</span><span class="road-panel__level"><span class="road-panel__level-dot road-panel__level-dot--red" aria-hidden="true"></span><span class="road-panel__level-text">A 級</span></span></div><div class="road-panel__row-meta"><span class="road-panel__saturation">飽和度：1</span><span class="road-panel__lane-status">車道狀態：Closed</span></div><span class="road-panel__provenance"><span class="road-panel__provenance-item">觀測時間：2026-05-20 22:00</span><span class="road-panel__provenance-item road-panel__provenance-item--stale">資料延遲：0 分鐘</span><span class="road-panel__provenance-item">狀態：ready</span></span></li></ul></div></div></section><section class="dashboard-region dashboard-region--crowd" aria-labelledby="crowd-heading"><h2 id="crowd-heading" class="dashboard-region__heading">基地台人流</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的基地台資料</span></div></div></section><section class="dashboard-region dashboard-region--decision" aria-labelledby="decision-heading"><h2 id="decision-heading" class="dashboard-region__heading">決策指令</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">目前尚無可顯示的決策結果</span></div><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的資料快照</span></div><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的受影響道路資訊</span></div></div></section><section class="dashboard-region dashboard-region--whatif" aria-labelledby="whatif-heading"><h2 id="whatif-heading" class="dashboard-region__heading">What-if 假設情境</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無 What-if 假設情境</span></div></div></section><section class="dashboard-region dashboard-region--injection" aria-labelledby="injection-heading"><h2 id="injection-heading" class="dashboard-region__heading">事件注入</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無事件注入內容</span></div></div></section></div></main><footer class="dashboard-footer" role="contentinfo"><p class="dashboard-footer__text">City Response Commander</p></footer></div>"`;

exports[`Dashboard wide/narrow layout snapshots > matches the narrow-layout snapshot (container width 375px) > dashboard-narrow-layout 1`] = `"<div class="dashboard-shell"><header class="dashboard-header" role="banner"><h1 class="dashboard-header__title">城市交通應變 AI 指揮台</h1><div class="operational-status-bar" role="region" aria-label="系統狀態"><span class="status-indicator status-indicator--fresh" role="status"><span class="status-indicator__dot" aria-hidden="true"></span><span class="status-indicator__text">資料為最新</span></span><span class="status-indicator status-indicator--connected" role="status" aria-live="off" data-connection-mode="websocket"><span class="status-indicator__dot" aria-hidden="true"></span><span class="status-indicator__icon" aria-hidden="true">⇄</span><span class="status-indicator__text">即時連線（WebSocket）</span></span></div></header><main class="dashboard-main" role="main"><div class="dashboard-grid"><section class="dashboard-region dashboard-region--timeline" aria-labelledby="timeline-heading"><h2 id="timeline-heading" class="dashboard-region__heading">時間軸</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="timeline-panel"><h3 class="timeline-panel__heading">時間軸重播</h3><div class="timeline-panel__status" role="status" aria-live="polite"></div><div class="timeline-panel__current" aria-live="polite"><span class="timeline-panel__current-label">目前重播位置</span><span class="timeline-panel__current-value">2026-05-20 22:00</span><span class="timeline-panel__position" aria-label="目前重播位置 1 / 2">1 / 2</span></div><div class="timeline-panel__controls"><button type="button" class="timeline-panel__nav" disabled="" aria-label="上一個時點">上一個</button><label class="timeline-panel__select-label" for="timeline-select">選擇時點</label><select id="timeline-select" class="timeline-panel__select"><option value="2026-05-20 22:00">2026-05-20 22:00</option><option value="2026-05-20 22:10">2026-05-20 22:10</option></select><button type="button" class="timeline-panel__nav" aria-label="下一個時點">下一個</button></div><p class="timeline-panel__selected">已選時點：2026-05-20 22:00<span class="timeline-panel__position timeline-panel__position--selected" aria-label="選擇位置 1 / 2">選擇位置 1 / 2</span></p></div></div></section><section class="dashboard-region dashboard-region--roads" aria-labelledby="roads-heading"><h2 id="roads-heading" class="dashboard-region__heading">路段車流</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="road-panel"><h3 class="road-panel__heading">路段車流</h3><div class="road-panel__status" role="status" aria-live="polite"></div><p class="road-panel__snapshot-timestamp">快照時間：2026-05-20 22:00</p><ul class="road-panel__list" aria-label="路段車流列表"><li class="road-panel__row" data-segment-id="RD_TPE_002"><div class="road-panel__row-main"><span class="road-panel__road-name">光復南路</span><span class="road-panel__segment-id">RD_TPE_002</span><span class="road-panel__level"><span class="road-panel__level-dot road-panel__level-dot--red" aria-hidden="true"></span><span class="road-panel__level-text">A 級</span></span></div><div class="road-panel__row-meta"><span class="road-panel__saturation">飽和度：1</span><span class="road-panel__lane-status">車道狀態：Closed</span></div><span class="road-panel__provenance"><span class="road-panel__provenance-item">觀測時間：2026-05-20 22:00</span><span class="road-panel__provenance-item road-panel__provenance-item--stale">資料延遲：0 分鐘</span><span class="road-panel__provenance-item">狀態：ready</span></span></li></ul></div></div></section><section class="dashboard-region dashboard-region--crowd" aria-labelledby="crowd-heading"><h2 id="crowd-heading" class="dashboard-region__heading">基地台人流</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="crowd-panel"><h3 class="crowd-panel__heading">基地台人流與信令</h3><div class="crowd-panel__status" role="status" aria-live="polite"></div><p class="crowd-panel__cutoff">決策截止時間：<span class="crowd-panel__cutoff-value">2026-05-20 22:10</span></p><section class="crowd-panel__policy" aria-labelledby="crowd-policy-heading"><h4 id="crowd-policy-heading" class="crowd-panel__policy-heading">政策揭露（OQ-005）</h4><p class="crowd-panel__badge crowd-panel__badge--provisional" role="note">臨時團隊政策（尚待主辦確認，非官方規則）</p><dl class="crowd-panel__policy-list"><div class="crowd-panel__policy-row"><dt>多語站集範圍政策</dt><dd class="crowd-panel__code">current_snapshot_all_available_stations</dd></div><div class="crowd-panel__policy-row"><dt>政策分類</dt><dd class="crowd-panel__code">PROVISIONAL_TEAM_POLICY</dd></div><div class="crowd-panel__policy-row"><dt>政策狀態</dt><dd class="crowd-panel__code">AWAITING_HOST_REPLY</dd></div><div class="crowd-panel__policy-row"><dt>是否官方規則</dt><dd>否</dd></div><div class="crowd-panel__policy-row"><dt>指引依據</dt><dd class="crowd-panel__code">HG-001</dd></div></dl><p class="crowd-panel__policy-note">OQ-005 之站集範圍維度仍為開放議題，以上模式為可配置之臨時政策。</p></section><table class="crowd-panel__table"><caption class="crowd-panel__table-caption">基地台人流與信令（數值與旗標皆由後端判定）</caption><thead><tr><th scope="col">基地台</th><th scope="col">人數</th><th scope="col">成長率</th><th scope="col">漫遊比率</th><th scope="col">SOP 旗標</th><th scope="col">觀測時間</th><th scope="col">資料延遲（分鐘）</th><th scope="col">納入多語範圍</th><th scope="col">資料狀態</th></tr></thead><tbody><tr class="crowd-panel__row" data-station-id="BS_MRT_BL17"><th scope="row" class="crowd-panel__station"><span class="crowd-panel__station-id">BS_MRT_BL17</span><span class="crowd-panel__station-name">捷運 BL17 站</span></th><td class="crowd-panel__cell crowd-panel__cell--count">31000</td><td class="crowd-panel__cell crowd-panel__cell--growth">0.42</td><td class="crowd-panel__cell crowd-panel__cell--roaming"><span class="crowd-panel__roaming-display">45%</span><span class="crowd-panel__roaming-value">（0.45）</span></td><td class="crowd-panel__cell crowd-panel__cell--flags"><ul class="crowd-panel__flags"><li class="crowd-panel__flag" data-flag="SOP3_MRT_SHUTTLE">SOP-3 捷運接駁分流</li></ul></td><td class="crowd-panel__cell crowd-panel__cell--observation"><span class="crowd-panel__observation">2026-05-20 22:00</span><span class="crowd-panel__exact-match">精確對齊：否</span></td><td class="crowd-panel__cell crowd-panel__cell--staleness"><span class="crowd-panel__staleness-minutes">5</span></td><td class="crowd-panel__cell crowd-panel__cell--scope">是</td><td class="crowd-panel__cell crowd-panel__cell--status"><span class="crowd-panel__code">ready</span></td></tr></tbody></table><section class="crowd-panel__multilingual" aria-labelledby="crowd-multilingual-heading"><h4 id="crowd-multilingual-heading" class="crowd-panel__subheading">多語通報判定（SOP 第 6 條）</h4><dl class="crowd-panel__multilingual-list"><div class="crowd-panel__multilingual-row"><dt>是否觸發</dt><dd>是</dd></div><div class="crowd-panel__multilingual-row"><dt>須多語發布</dt><dd>是</dd></div><div class="crowd-panel__multilingual-row"><dt>判定資料狀態</dt><dd class="crowd-panel__code">ready</dd></div><div class="crowd-panel__multilingual-row"><dt>觸發站點</dt><dd>BS_MRT_BL17</dd></div><div class="crowd-panel__multilingual-row"><dt>納入範圍站點</dt><dd>BS_MRT_BL17</dd></div></dl></section></div></div></section><section class="dashboard-region dashboard-region--decision" aria-labelledby="decision-heading"><h2 id="decision-heading" class="dashboard-region__heading">決策指令</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">目前尚無可顯示的決策結果</span></div><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的資料快照</span></div><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無可顯示的受影響道路資訊</span></div></div></section><section class="dashboard-region dashboard-region--whatif" aria-labelledby="whatif-heading"><h2 id="whatif-heading" class="dashboard-region__heading">What-if 假設情境</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無 What-if 假設情境</span></div></div></section><section class="dashboard-region dashboard-region--injection" aria-labelledby="injection-heading"><h2 id="injection-heading" class="dashboard-region__heading">事件注入</h2><div class="dashboard-region__content dashboard-region__content--stacked"><div class="async-state async-state--empty" role="status"><span class="async-state__text">尚無事件注入內容</span></div></div></section></div></main><footer class="dashboard-footer" role="contentinfo"><p class="dashboard-footer__text">City Response Commander</p></footer></div>"`;

