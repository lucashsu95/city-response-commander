{
  "name": "city-response-commander",
  "version": "0.1.0",
  "private": true,
  "description": "城市交通應變 AI 指揮台 — 2026 雲湧智生黑客松競賽",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "typecheck": "tsc --build",
    "check:language-boundary": "tsx scripts/check-language-boundary.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  }
}
