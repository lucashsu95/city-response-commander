{
  "name": "city-response-commander",
  "version": "0.1.0",
  "private": true,
  "description": "城市交通應變 AI 指揮台 — 2026 雲湧智生黑客松競賽",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@city-commander/frontend",
    "demo": "npm run build:frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lint-rule": "vitest run eslint-local-rules/test/no-llm-prohibited-field-write.test.ts",
    "test:credential-scan": "vitest run scripts/test/check-no-credentials.test.ts",
    "test:source-gate": "vitest run scripts/test/verify_sources.test.ts",
    "mock:bedrock-walkthrough": "tsx scripts/mock-bedrock-walkthrough.ts",
    "rehearsal:dry-run": "bash scripts/local_mock_rehearsal.sh --dry-run",
    "lint": "eslint packages/*/src/**/*.ts scripts/**/*.ts infra/bin/**/*.ts infra/lib/**/*.ts",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"infra/bin/**/*.ts\" \"infra/lib/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\" \"infra/bin/**/*.ts\" \"infra/lib/**/*.ts\"",
    "typecheck": "tsc --build",
    "check:language-boundary": "tsx scripts/check-language-boundary.ts",
    "check:no-credentials": "bash scripts/check-no-credentials.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-local-rules": "3.0.2",
    "prettier": "3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
