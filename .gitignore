# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# AWS CDK
cdk.out/
.cdk.staging/

# AWS credentials and config (NEVER commit)
.aws/
credentials*
**/credentials
**/credentials.*

# Secrets and keys (NEVER commit)
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.bak
*.orig

# Python (if boundary exists)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# One-time recovery/scratch artifacts
fix_utf8/
