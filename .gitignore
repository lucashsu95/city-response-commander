# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Infra generated outputs (JS/dTS from TypeScript compilation)
infra/bin/*.js
infra/bin/*.d.ts
infra/bin/*.d.ts.map
infra/bin/*.js.map
infra/lib/*.js
infra/lib/*.d.ts
infra/lib/*.d.ts.map
infra/lib/*.js.map
infra/test/*.test.js
infra/test/*.test.d.ts
infra/test/*.test.d.ts.map
infra/test/*.test.js.map

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# AWS CDK
cdk.out/
cdk.out.competition/
.cdk.staging/

# AWS credentials and config (NEVER commit)
.aws/
credentials*
**/credentials
**/credentials.*

# Secrets and keys (NEVER commit)
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.bak
*.orig

# Python (if boundary exists)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# One-time recovery/scratch artifacts
fix_utf8/

# Harness Engine (agent infrastructure)
.opencode/
docs/handoff-notes/
boulder.json
