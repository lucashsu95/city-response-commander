{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FrontendS3BucketLevel",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::city-commander-frontend-873354961545-us-west-2"
    },
    {
      "Sid": "FrontendS3ObjectLevel",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::city-commander-frontend-873354961545-us-west-2/*"
    },
    {
      "Sid": "FrontendCloudFrontInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:GetDistribution"
      ],
      "Resource": "arn:aws:cloudfront::873354961545:distribution/*"
    },
    {
      "Sid": "FrontendCloudFormationRead",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:us-west-2:873354961545:stack/CityCommanderFrontend/*"
    }
  ]
}
